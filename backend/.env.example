# Copy this file to .env. Never commit the .env file.
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
ALLOWED_HOSTS=localhost,127.0.0.1

# Browser origins permitted to call the API. A browser
# compares origins as literal strings, so the IPv6 form is a
# separate origin from the other two even though it reaches
# the same server. All three are listed because the Vite
# development server binds whichever one the host resolves
# "localhost" to.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173

SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://forest_user:change-me@db:5432/forest_detection

# ---------------------------------------------------------
# Copernicus Data Space Ecosystem
#
# Account used to search for and download Sentinel-2
# products.
# ---------------------------------------------------------
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# ---------------------------------------------------------
# Sentinel Hub WMS
#
# The instance identifier selects a configured set of
# visualisation layers. It is a credential: anyone holding
# it can draw against the account's quota, so it must never
# be committed or exposed to the browser.
#
# The layer names must match the layers defined in that
# instance's configuration.
# ---------------------------------------------------------
SENTINEL_WMS_INSTANCE_ID=
SENTINEL_WMS_BASE_URL=https://sh.dataspace.copernicus.eu/ogc/wms
SENTINEL_LAYER_TRUE_COLOUR=1_TRUE_COLOR
SENTINEL_LAYER_FALSE_COLOUR=2_FALSE_COLOR
SENTINEL_LAYER_NDVI=3_NDVI

# ---------------------------------------------------------
# Email notifications
#
# Used to alert officers when deforestation is detected in
# the area they are responsible for.
# ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ---------------------------------------------------------
# SMS notifications (Africa's Talking)
#
# A second alert channel, for clearings serious enough to
# warrant a field visit. Email still goes out for every
# alert.
#
# AFRICASTALKING_USERNAME
#   For the sandbox this is ALWAYS the literal word
#   sandbox, whatever the account is called. The provider
#   selects its sandbox endpoint from this value alone.
#
# AFRICASTALKING_API_KEY
#   A credential. Leave it empty here, set it only in .env,
#   and never commit it. It is sent to the provider in a
#   request header; it is never logged, never returned by
#   an endpoint and never reaches the browser.
#
# AFRICASTALKING_ENVIRONMENT
#   Anything other than the word production means sandbox,
#   and the username is overridden to sandbox accordingly.
#   Production is therefore opt-in by one explicit value,
#   so a key left here cannot text a real handset during
#   development.
#
# SMS_SENDER_ID
#   A registered shortcode or alphanumeric sender ID. Leave
#   it empty for the sandbox, which has none of its own.
#
# SMS_ENABLED
#   Off by default, so installing the dependency and
#   running the migration does not by itself start sending.
#
# SMS_MIN_PRIORITY
#   Lowest alert priority that earns an SMS: LOW, MEDIUM,
#   HIGH or CRITICAL. An unrecognised value sends nothing.
#
# Recipients come from users.phone_number. An officer
# without one is skipped, as one without an email address
# already is.
# ---------------------------------------------------------
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_ENVIRONMENT=sandbox
SMS_SENDER_ID=
SMS_ENABLED=false
SMS_MIN_PRIORITY=HIGH

# ---------------------------------------------------------
# Detection thresholds
#
# Defaults are applied when these are not set.
#   NDVI_THRESHOLD             minimum NDVI decline
#   MIN_DETECTION_AREA_HECTARES  0.5 ha = 50 Sentinel-2
#                                pixels at 10 m
# ---------------------------------------------------------
NDVI_THRESHOLD=0.30
MIN_DETECTION_AREA_HECTARES=0.50
MAX_CLOUD_COVER_PERCENTAGE=30.0
