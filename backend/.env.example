# Copy this file to .env. Never commit the .env file.
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
ALLOWED_HOSTS=localhost,127.0.0.1
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://forest_user:change-me@db:5432/forest_detection

# ---------------------------------------------------------
# Copernicus Data Space Ecosystem
#
# Account used to search for and download Sentinel-2
# products.
# ---------------------------------------------------------
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# ---------------------------------------------------------
# Sentinel Hub WMS
#
# The instance identifier selects a configured set of
# visualisation layers. It is a credential: anyone holding
# it can draw against the account's quota, so it must never
# be committed or exposed to the browser.
#
# The layer names must match the layers defined in that
# instance's configuration.
# ---------------------------------------------------------
SENTINEL_WMS_INSTANCE_ID=
SENTINEL_WMS_BASE_URL=https://sh.dataspace.copernicus.eu/ogc/wms
SENTINEL_LAYER_TRUE_COLOUR=1_TRUE_COLOR
SENTINEL_LAYER_FALSE_COLOUR=2_FALSE_COLOR
SENTINEL_LAYER_NDVI=3_NDVI

# ---------------------------------------------------------
# Email notifications
#
# Used to alert officers when deforestation is detected in
# the area they are responsible for.
# ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ---------------------------------------------------------
# Detection thresholds
#
# Defaults are applied when these are not set.
#   NDVI_THRESHOLD             minimum NDVI decline
#   MIN_DETECTION_AREA_HECTARES  0.5 ha = 50 Sentinel-2
#                                pixels at 10 m
# ---------------------------------------------------------
NDVI_THRESHOLD=0.30
MIN_DETECTION_AREA_HECTARES=0.50
MAX_CLOUD_COVER_PERCENTAGE=30.0
